{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user including admin, gestor, captador",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "username": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "role": { "type": "string" },
        "position": { "type": "string" },
        "status": { "type": "string" },
        "creci": { "type": "string" }
      },
      "required": ["id", "name", "username", "role"]
    },
    "Property": {
      "title": "Property",
      "description": "Real estate property listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "title": { "type": "string" },
        "price": { "type": "number" },
        "user_id": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "code", "title", "user_id", "status"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Daily captador activity journal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "user_name": { "type": "string" },
        "date": { "type": "string" },
        "summary_notes": { "type": "string" },
        "leads_prospectados": { "type": "number" },
        "imoveis_captados": { "type": "number" },
        "visitas_realizadas": { "type": "number" }
      },
      "required": ["id", "user_id", "date"]
    },
    "ScheduleEvent": {
      "title": "ScheduleEvent",
      "description": "Calendar event or scheduled visit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "start_time": { "type": "string" },
        "user_id": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "title", "date", "start_time", "type"]
    },
    "CompanySettings": {
      "title": "CompanySettings",
      "description": "Company global settings and branding",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "creci": { "type": "string" }
      },
      "required": ["companyName"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System activity audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "user_name": { "type": "string" },
        "action": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "user_id", "action", "description"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/properties/{propertyId}": {
      "schema": { "$ref": "#/entities/Property" },
      "description": "Property listings"
    },
    "/journal/{entryId}": {
      "schema": { "$ref": "#/entities/JournalEntry" },
      "description": "Captador daily journals"
    },
    "/schedule/{eventId}": {
      "schema": { "$ref": "#/entities/ScheduleEvent" },
      "description": "Schedule events"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/CompanySettings" },
      "description": "Settings"
    },
    "/logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Audit logs"
    }
  }
}

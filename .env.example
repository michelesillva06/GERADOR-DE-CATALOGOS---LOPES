# LOPES MANAUS - GERADOR DE CATÁLOGOS IMOBILIÁRIOS
# Arquivo de configuração de variáveis de ambiente

# Porta do servidor
PORT=3000
NODE_ENV=development

# Chave secreta para assinatura de tokens JWT
JWT_SECRET=lopes_manaus_secret_key_2026

# URL do banco de dados PostgreSQL
DATABASE_URL=postgres://lopes_user:lopes_pass@localhost:5432/lopes_db

# URL base da aplicação hospedada (Netlify / Cloud Run / Render)
APP_URL=http://localhost:3000

# Chave API opcional do Gemini para geração inteligente de descrições
GEMINI_API_KEY=

# Cloudinary (armazenamento persistente de imagens e capas)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
